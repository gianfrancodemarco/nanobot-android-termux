#!/data/data/com.termux/files/usr/bin/bash
# Gateway supervisor, run by nanobot-ctl in the nanobot-host tmux session. Logs to ~/nanobot-logs/gateway.log.
set +e
export PATH="/data/data/com.termux/files/usr/bin:${PATH:-}"
export PROOT_NO_SECCOMP=1

LOG="$HOME/nanobot-logs/gateway.log"
mkdir -p "$HOME/nanobot-logs"

while true; do
  echo "[$(date)] start nanobot gateway" | tee -a "$LOG"
  proot-distro login debian -- /bin/bash -lc \
    'source /root/nanobot-env/bin/activate && exec nanobot gateway' 2>&1 | tee -a "$LOG"
  echo "[$(date)] gateway exit rc=${PIPESTATUS[0]} (132=SIGILL, try: nanobot-ctl debug); restart in 10s" | tee -a "$LOG"
  sleep 10
done
