#!/data/data/com.termux/files/usr/bin/bash
# Gateway supervisor — logs to ~/nanobot-logs/gateway.log (and tmux pane via tee).
set +e
export PATH="/data/data/com.termux/files/usr/bin:${PATH:-}"
export PROOT_NO_SECCOMP=1

LOG="$HOME/nanobot-logs/gateway.log"
mkdir -p "$HOME/nanobot-logs"

run_gateway_in_debian() {
  proot-distro login debian -- /bin/bash -lc '
set +e
source /root/nanobot-env/bin/activate
# Some CLIs exit when stdin is not a TTY under proot; script provides a pseudo-TTY.
if command -v script >/dev/null 2>&1; then
  exec script -qefc "exec nanobot gateway" /dev/null
else
  exec nanobot gateway
fi
'
}

echo "[$(date)] nanobot-loop started (pid $$)" | tee -a "$LOG"

while true; do
  echo "[$(date)] start nanobot gateway" | tee -a "$LOG"
  run_gateway_in_debian 2>&1 | tee -a "$LOG"
  rc=${PIPESTATUS[0]}
  echo "[$(date)] gateway exit rc=$rc; sleep 10s" | tee -a "$LOG"
  echo "[$(date)] --- debian /root/.nanobot/logs/gateway.log (last 25 lines) ---" | tee -a "$LOG"
  proot-distro login debian -- /bin/bash -lc 'tail -n 25 /root/.nanobot/logs/gateway.log 2>/dev/null' 2>&1 | tee -a "$LOG" || true
  echo "[$(date)] hint: run collect-nanobot-logs and share the report file" | tee -a "$LOG"
  sleep 10
done
